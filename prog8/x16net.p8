; Reference credits: David Murray's ROMTERM and TexElec's X16 serial/network card.
; https://texelec.com/product/commander-x16-serial-network-card/
; Generated by tools/generate_bindings.py. Default binary address $8000.
x16net {
    const ubyte ERR_OK = 0
    const ubyte ERR_AGAIN = 1
    const ubyte ERR_TIMEOUT = 2
    const ubyte ERR_BADARG = 3
    const ubyte ERR_NOCARD = 4
    const ubyte ERR_STATE = 5
    const ubyte ERR_EOF = 6
    const ubyte ERR_IOERR = 7
    const ubyte ERR_MODEM = 8
    const ubyte ERR_OVERFLOW = 9
    extsub $8000 = init(ubyte baud @A, uword port @XY) clobbers(X,Y) -> ubyte @A, bool @Pc
    extsub $8003 = shutdown() clobbers(X,Y) -> ubyte @A, bool @Pc
    extsub $8006 = get_byte() clobbers(X,Y) -> ubyte @A, bool @Pc
    extsub $8009 = put_byte(ubyte value @A) clobbers(X,Y) -> ubyte @A, bool @Pc
    extsub $800c = read(ubyte length @A, uword buffer @XY) clobbers() -> ubyte @A, uword @XY, bool @Pc
    extsub $800f = write(ubyte length @A, uword buffer @XY) clobbers() -> ubyte @A, uword @XY, bool @Pc
    extsub $8012 = status() clobbers() -> ubyte @A, ubyte @X, ubyte @Y, bool @Pc
    extsub $8015 = set_timeout(ubyte high @A, uword low @XY) clobbers(X,Y) -> ubyte @A, bool @Pc
    extsub $8018 = prepare() clobbers(X,Y) -> ubyte @A, bool @Pc
    extsub $801b = connect(uword endpoint @XY) clobbers(X,Y) -> ubyte @A, bool @Pc
    extsub $801e = disconnect() clobbers(X,Y) -> ubyte @A, bool @Pc
    extsub $8021 = abi_info() clobbers() -> ubyte @A, uword @XY, bool @Pc
}
